# Example environment variables for Local LLMs
# Copy this file to .env and customize as needed

# Encryption key for data security
# Generate a new key or use a secure password
ENCRYPTION_KEY=your_secure_encryption_key_here

# Model cache directory (optional, overrides config)
# MODEL_CACHE_DIR=./models_cache

# Device to use (optional, overrides config)
# DEVICE=cuda
# DEVICE=cpu
# DEVICE=mps

# HuggingFace token (optional, for private models)
# HF_TOKEN=hf_your_token_here
